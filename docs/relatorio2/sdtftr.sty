\oddsidemargin  -2truemm
%\evensidemargin 0truein
\topmargin 0truein
\headheight 0.0truein
\headsep 0truein
\textheight 7.7truein
\textwidth 5.35truein
%\textheight 9truein
%\textwidth 6.5truein


\font\smallheadfont=cmss9
\font\largeheadfont=cmss17

\def\@coverart{\special{itlogo.jpg 
					%voffset=-150 hscale=60 vscale=60
					%hsize=20 vsize=20
					}}
\def\reportnumber#1{\def\@reportnumber{#1}}
\def\reportmonth#1{\def\@reportmonth{#1}}
\def\reportyear#1{\def\@reportyear{#1}}
\def\@reportnumber{????}
\def\@reportmonth{}
\def\@reportyear{????}
\def\@numberformatter{\largeheadfont SDTF UBI Technical Report}

\def\makecover{
\titlepage   
\def\thanks##1{\relax}
\setcounter{page}{1}
\ifx\@empty\@reportyear%
    \def\@reportdesignator{\@reportnumber}
\else%
    \date{\@reportmonth\ \@reportyear}%
    \@tempcnta\@reportyear%
    \divide\@tempcnta by 100%
    \multiply\@tempcnta by 100%
    \@tempcntb\@reportyear%
    \advance\@tempcntb-\@tempcnta%
    \edef\@reportdesignator{\@reportyear-\@reportnumber}%
\fi
\shipout
\vbox to 8.1true in
{
\hsize=5.35true in\parindent=0.5true in
{

\hrule
\vbox to 1.0true in{\vfil}
\vbox to 0.25true in{\vfil}
\noindent\begin{minipage}[t]{5.35 true in}
\LARGE\bf
\begin{center}
\@title
\end{center}
\end{minipage}

\vbox to 0.625true in{\vfil}

\noindent\begin{minipage}[t]{5.35 true in}
\Large\it
\begin{center}
{\lineskip .75em\begin{tabular}[t]{c}\@author\end{tabular}\par}%
\end{center}
\end{minipage}

% \vbox to 2.625true in{\vfil}

\vfill

\hrule

\vbox to 0.2true in{\vfil}

{
\@coverart
\hspace{2.55true in}
\begin{minipage}[t]{3.5true in}
\large\parindent=0pt
{\bf \@numberformatter} \\
\includegraphics[scale=0.98]{images/ubi.JPG}
\vspace{1ex}
\noindent \@date \\
\vspace{2ex} \\
\end{minipage}
}}
}
\renewcommand{\@oddfoot}{
UBI-\@reportdesignator \hfil \thepage }%
}

\def\blankpage{
  \newpage
  \null
 }
 
\def\@maketitle{%
  \newpage
  \null
  \vskip 2em%
  \begin{center}%
  \let \footnote \thanks
    {\LARGE \@title \par}%
    \vskip 1.5em%
    {\large
      \lineskip .5em%
      \begin{tabular}[t]{c}%
        \@author
      \end{tabular}\par}%
    \vskip 1em%
    {\em Technical Report-\@reportdesignator}%
    \vskip .5em%
    {\large \@date}%
  \end{center}%
  \par
  \vskip 1.5em
}
